# ---------------------------------------------------------------
# SETUP INSTRUCTIONS
# ---------------------------------------------------------------
# 1. Copy this file and rename it to .env  (never commit .env)
#       cp .env.example .env
#
# 2. Fill in every value marked with YOUR_... below.
#
# 3. For MONGO_URI:
#    - Go to MongoDB Atlas -> Database Access -> Add New Database User
#    - Create a user with read/write access to the "giu-nexus" database
#    - Replace YOUR_DB_USER and YOUR_DB_PASS with that user's credentials
#    - Do NOT change anything else in the URI
#
# 4. For JWT_SECRET: generate a random string, e.g. run:
#       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 5. For HF_TOKEN: get a free token from https://huggingface.co/settings/tokens
#
# 6. For EMAIL_*: use a Gmail address and an App Password (not your real password)
#    - Enable 2FA on your Google account first
#    - Then go to https://myaccount.google.com/apppasswords to generate one
# ---------------------------------------------------------------

PORT=5000

# MongoDB — replace YOUR_DB_USER and YOUR_DB_PASS only
MONGO_URI=mongodb://YOUR_DB_USER:YOUR_DB_PASS@ac-bt4jd45-shard-00-00.7cfmnk5.mongodb.net:27017,ac-bt4jd45-shard-00-01.7cfmnk5.mongodb.net:27017,ac-bt4jd45-shard-00-02.7cfmnk5.mongodb.net:27017/giu-nexus?ssl=true&replicaSet=atlas-4oey72-shard-0&authSource=admin&retryWrites=true&w=majority

# JSON Web Token
JWT_SECRET=YOUR_RANDOM_64_CHAR_HEX_STRING
JWT_EXPIRE=7d

# Hugging Face API
HF_TOKEN=YOUR_HF_TOKEN

# Email (Gmail + App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=YOUR_GMAIL_ADDRESS
EMAIL_PASS=YOUR_GMAIL_APP_PASSWORD

# Cloudinary — profile picture uploads
# Sign up at https://cloudinary.com and copy these from your dashboard
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_SECRET=YOUR_API_SECRET
